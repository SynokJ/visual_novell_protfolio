  nameText: "\u0410\u0439\u043A\u0430 (\u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435):"
  speachText: "\u041D\u0438 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u0439,
    \u043D\u0438 \u0441\u043C\u0443\u0449\u0435\u043D\u0438\u044F, \u043F\u0440\u043E\u0441\u0442\u043E
    \u044D\u0442\u043E \u0435\u0433\u043E \u201C\u0438\u0434\u0443\u201D, \u0441\u043B\u043E\u0432\u043D\u043E
    \u0432\u0441\u0435 \u0432\u043E\u043A\u0440\u0443\u0433 \u0434\u043E\u043B\u0436\u043D\u044B
    \u043F\u043E\u0434\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0434
    \u043D\u0435\u0433\u043E.  \u041D\u0430\u0433\u043B\u044B\u0439 \u0434\u043E
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438."
