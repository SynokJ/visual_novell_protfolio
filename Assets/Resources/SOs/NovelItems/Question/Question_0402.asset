  firstChoiceText: "\u201C\u0422\u044B \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u043D \u0436\u0438\u0442\u044C \u043F\u043E \u0435\u0433\u043E \u043F\u043B\u0430\u043D\u0443.\u201D"
  secondChoiceText: "\u201C\u0422\u043E\u0433\u0434\u0430 \u0434\u043E\u043A\u0430\u0436\u0438 \u0438\u043C, \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A \u043E\u043D\u0438 \u0434\u0443\u043C\u0430\u044E\u0442.\u201D"
  thirdChoiceText: "\u201C\u0412\u0441\u0435 \u0442\u0430\u043A \u0436\u0438\u0432\u0443\u0442. \u041F\u0440\u0438\u0432\u044B\u043A\u0430\u0439.\u201D"
