  thirdChoiceModel: {fileID: 11400000, guid: 37f8472fda3945b88907dd9edc09f2ae, type: 2}
  firstChoiceText: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043C\u043E\u043B\u0447\u0430 \u0438 \u0432\u0441\u0442\u0430\u0442\u044C \u0440\u044F\u0434\u043E\u043C"
  secondChoiceText: "\u201C\u042D\u0439. \u0422\u044B \u0447\u0435\u0433\u043E \u0442\u0443\u0442?\u201D"
  thirdChoiceText: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E, \u043D\u043E \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C \u0448\u0430\u0433"
