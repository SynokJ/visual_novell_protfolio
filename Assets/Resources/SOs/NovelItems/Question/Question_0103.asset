  m_Script: {fileID: 11500000, guid: a512d355c4f36374aa8a32af8e7974e9, type: 3}
  m_Name: Question_0103
  m_EditorClassIdentifier: Assembly-CSharp::NovelItemChoiceableModel
  nameText: "\u0410\u0439\u043A\u0430 (\u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435):"
  speachText: "\u201C\u0427\u0442\u043E \u043E\u043D \u0441\u0435\u0431\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442???.\u201D"
  characterSprite: {fileID: 21300000, guid: bcd3b51c76f383d48bf175fdaae2347e, type: 3}
  backgroundSprite: {fileID: 21300000, guid: 0cc680a868568754c9348b6e67fbd022, type: 3}
  characterAnimTrigger: fromLeft
  editorNodeColor: {r: 1, g: 0, b: 0, a: 1}
  firstChoiceModel: {fileID: 11400000, guid: c21be50f2d4e8564eabdb0ba7107af05, type: 2}
  secondChoiceModel: {fileID: 11400000, guid: 31dde5e5d8895744290402798afae54b, type: 2}
  thirdChoiceModel: {fileID: 11400000, guid: 520c9a7b8a1c9874bbe6955aff2b744c, type: 2}
  firstChoiceText: "\u201C\u0417\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0433\u043E \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
    \u043E\u0442 \u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0441 \u0442\u043E\u0431\u043E\u0439,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E.\u201D"
  secondChoiceText: "\u201C\u041C\u043E\u0433\u0443 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0442\u0430\u043A. \u0418\u043D\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u044F\u043C
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043D\u0435 \u0438\u0437-\u0437\u0430
    \u0432\u044B\u0433\u043E\u0434\u044B.\u201D"
  thirdChoiceText: "\u201C\u041D\u0435 \u043E\u0431\u043E\u043B\u044C\u0449\u0430\u0439\u0441\u044F. 
    \u041F\u0440\u043E\u0441\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0440\u0432\u044B
    \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
    \u043A\u0430\u043A \u0442\u044B \u043F\u043E\u0437\u043E\u0440\u0438\u0448\u044C\u0441\u044F.\u201D"
