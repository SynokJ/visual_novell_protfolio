  nameText: "\u0422\u0438\u043C\u0443\u0440:"
  speachText: "\u201C\u0421\u0447\u0438\u0442\u0430\u0435\u0448\u044C \u043C\u0435\u043D\u044F
    \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C?\u201D"
  characterSprite: {fileID: 21300000, guid: bcd3b51c76f383d48bf175fdaae2347e, type: 3}
  backgroundSprite: {fileID: -3423043350003973055, guid: cc5d0e24eb685bc47b8cef0b21da3341, type: 3}
  characterAnimTrigger: fromLeft
  editorNodeColor: {r: 1, g: 0, b: 0, a: 1}
  firstChoiceModel: {fileID: 11400000, guid: 916bb5cfb6ac9eb40a67c511e1fcc7ee, type: 2}
  secondChoiceModel: {fileID: 11400000, guid: 5ad65f8a8ceecf24bb900f17ea2b63d0, type: 2}
  thirdChoiceModel: {fileID: 11400000, guid: 5f1532b40e980c6419bf3ecdb9bc3a2f, type: 2}
  firstChoiceText: "\u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E
    \u0443 \u0442\u0435\u0431\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
    \u0441\u0430\u043C\u043E\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430 \u043E\u0434\u0438\u043D \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439
    \u043C\u0435\u0442\u0440."
  secondChoiceText: " \u041D\u0435 \u043B\u044C\u0441\u0442\u0438 \u0441\u0435\u0431\u0435.
    \u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435,
    \u0430 \u043D\u0435 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442. "
  thirdChoiceText: "\u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0439? \u041A\u0430\u043A
    \u043F\u0440\u043E\u0441\u043F\u0435\u043A\u0442 \u0427\u0438\u043D\u0433\u0438\u0437\u0430
    \u0410\u0439\u0442\u043C\u0430\u0442\u043E\u0432\u0430 \u043F\u043E\u0441\u043B\u0435
    \u0432\u044B\u0440\u0443\u0431\u043A\u0438 \u0442\u043E\u043F\u043E\u043B\u0435\u0439"
