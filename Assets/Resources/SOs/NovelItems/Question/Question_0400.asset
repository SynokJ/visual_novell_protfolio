  firstChoiceText: "\u201C\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?\u201D"
  secondChoiceText: "\u201C\u041C\u043D\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E. \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0443 \u0434\u043E\u043C\u043E\u0439.\u201D"
  thirdChoiceText: "\u201C\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u0430\u043C \u0443 \u0442\u0435\u0431\u044F, \u043D\u043E \u0441\u0438\u0434\u0435\u0442\u044C \u0442\u0443\u0442 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u2014 \u0442\u0443\u043F\u043E.\u201D"
